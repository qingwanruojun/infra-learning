+# AscendNPU-IR renamed the HIVM sync-block attribute `syn_instr_mode` to
+# `sync_instr_mode`. The in-tree AscendNPU-IR build pinned by this branch still
+# uses the old spelling, while the CANN 9.0.0 toolchain only accepts the new
+# one and rejects expert-mode IR with:
+#   error: Dialect `' not found for custom op 'syn_instr_mode'
+# The JIT rewrites the attribute when it detects a new-style compiler.
+_NPUIR_SYNC_ATTR_OLD = "syn_instr_mode"
+_NPUIR_SYNC_ATTR_NEW = "sync_instr_mode"
+
+# CANN 9.0.0's bishengir-compile can die with SIGSEGV inside the
+# ConvertHFusionToHIVM pass on MIX (expert-mode) modules. The crash is not
+# deterministic: the same input compiles on a later attempt. Retry
+# signal-terminated compiles instead of surfacing a spurious failure.
+_NPUIR_COMPILE_MAX_ATTEMPTS = 8
+
+
+@functools.lru_cache(maxsize=None)
+def _npuir_compiler_version(compiler_path: str) -> str:
+    """First line of `<compiler> --version`, or "" when it cannot be read."""
+    try:
+        proc = subprocess.run(
+            [compiler_path, "--version"],
+            capture_output=True,
+            check=False,
+            text=True,
+            timeout=60,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return ""
+    first_line = proc.stdout.strip().splitlines()
+    return first_line[0] if first_line else ""
+
+
+@functools.lru_cache(maxsize=None)
+def _npuir_needs_sync_attr_rename(compiler_path: str) -> bool:
+    """Whether the compiler expects `sync_instr_mode` instead of `syn_instr_mode`.
+
+    The in-tree AscendNPU-IR build reports
+    ``bishengir-compile version 19.1.7 (...)``; the CANN 9.0.0 toolchain
+    reports ``bishengir-compile 1.1.0 (...)``. When the version is unknown we
+    keep the old spelling and fall back to renaming after a parse failure.
+    """
+    version_line = _npuir_compiler_version(compiler_path)
+    if not version_line:
+        return False
+    return "bishengir-compile version" not in version_line
+
+
 class compiler_npu:
     def __init__(self) -> None:
         pass
