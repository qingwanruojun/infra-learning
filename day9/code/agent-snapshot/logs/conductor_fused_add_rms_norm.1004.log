# norm.yaml -- manifest entries for the 'norm' family (NPU benchmark).
#
# Standalone spec; no dependency on the TileOPs repository.
# Ported from TileOPs ``tileops/manifest/normalization.yaml`` --
# AdaLayerNormFwdOp entry only (the neighbouring AdaLayerNormZeroFwdOp and
# the other norm entries are not migrated yet).
#
# Note: the GPU repo names the manifest file ``normalization.yaml`` while its
# ops/kernels family directory is ``norm``; the NPU project keeps one name
# (``norm``) for the manifest file, workload module, and package directories.
# See docs/gpu_to_npu_adaptation.md for the GPU-to-NPU adaptation notes.

AdaLayerNormFwdOp:
  ref_api: "none"
  family: norm
  status: implemented

  signature:
    inputs:
      x: {dtype: "float32 | float16 | bfloat16"}
      scale: {dtype: "same_as(x)"}
      shift: {dtype: "same_as(x)"}
    outputs:
      output: {dtype: "same_as(x)"}
    params:
      eps: {type: float, default: 1.0e-5}
    shape_rules:
      - "scale.shape == x.shape"
      - "shift.shape == x.shape"
      - "output.shape == x.shape"
